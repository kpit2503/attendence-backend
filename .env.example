DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
SECRET=replace-with-a-long-random-secret
# Comma-separated URLs allowed to call the API. Leave empty when the app and API share a Render service.
CORS_ORIGINS=https://your-frontend.onrender.com
# SMTP credentials used to send password-reset links to registered addresses.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=your-email@example.com
# Public URL where this app is served (no trailing slash).
FRONTEND_URL=https://your-app.onrender.com
